# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    # Get environment variables
    app_identifier = ENV["APP_IDENTIFIER"]
    app_name = ENV["IOS_APP_NAME"] || "EruptionGrid"
    app_version = ENV["APP_VERSION"] || "1.0.0"
    xcode_project_path = ENV["XCODE_PROJECT_PATH"] || "build/ios"
    
    # Set up App Store Connect API Key
    app_store_connect_api_key(
      key_id: ENV["APPSTORE_KEY_ID"],
      issuer_id: ENV["APPSTORE_ISSUER_ID"],
      key_content: ENV["APPSTORE_P8"],
      duration: 1200, # optional
      in_house: false # optional but may be required if using match/sigh
    )
    
    # Find the Xcode project or workspace
    project_path = find_project_or_workspace(xcode_project_path)
    
    if project_path.nil?
      UI.user_error!("No Xcode project or workspace found in #{xcode_project_path}")
    end
    
    UI.message("Using project: #{project_path}")
    
    # Set up code signing with match
    match(
      type: "appstore",
      app_identifier: app_identifier,
      git_url: ENV["MATCH_REPOSITORY"],
      readonly: true,
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: ""
    )
    
    # Update project settings
    update_project_provisioning(
      xcodeproj: project_path.end_with?('.xcworkspace') ? nil : project_path,
      target_filter: "Unity-iPhone", # Unity's default target name
      profile: ENV["sigh_#{app_identifier}_appstore_profile-path"] || Actions.lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][app_identifier],
      build_configuration: "Release"
    )
    
    # Update project team
    update_project_team(
      path: project_path.end_with?('.xcworkspace') ? nil : project_path,
      teamid: ENV["APP_STORE_CONNECT_TEAM_ID"]
    )
    
    # Increment build number
    increment_build_number(
      xcodeproj: project_path.end_with?('.xcworkspace') ? nil : project_path
    )
    
    # Update version number if provided
    if app_version
      increment_version_number(
        version_number: app_version,
        xcodeproj: project_path.end_with?('.xcworkspace') ? nil : project_path
      )
    end
    
    # Build the app
    if project_path.end_with?('.xcworkspace')
      build_app(
        workspace: project_path,
        scheme: "Unity-iPhone",
        configuration: "Release",
        export_method: "app-store",
        export_options: {
          provisioningProfiles: {
            app_identifier => ENV["sigh_#{app_identifier}_appstore_profile-name"] || Actions.lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][app_identifier]
          }
        }
      )
    else
      build_app(
        project: project_path,
        scheme: "Unity-iPhone",
        configuration: "Release",
        export_method: "app-store",
        export_options: {
          provisioningProfiles: {
            app_identifier => ENV["sigh_#{app_identifier}_appstore_profile-name"] || Actions.lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][app_identifier]
          }
        }
      )
    end
    
    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false
    )
    
    UI.success("Successfully uploaded #{app_name} v#{app_version} to TestFlight! 🚀")
  end
  
  desc "Build and upload to App Store"
  lane :release do
    # Get environment variables
    app_identifier = ENV["APP_IDENTIFIER"]
    app_name = ENV["IOS_APP_NAME"] || "EruptionGrid"
    app_version = ENV["APP_VERSION"] || "1.0.0"
    xcode_project_path = ENV["XCODE_PROJECT_PATH"] || "build/ios"
    
    # Set up App Store Connect API Key
    app_store_connect_api_key(
      key_id: ENV["APPSTORE_KEY_ID"],
      issuer_id: ENV["APPSTORE_ISSUER_ID"],
      key_content: ENV["APPSTORE_P8"],
      duration: 1200,
      in_house: false
    )
    
    # Find the Xcode project or workspace
    project_path = find_project_or_workspace(xcode_project_path)
    
    if project_path.nil?
      UI.user_error!("No Xcode project or workspace found in #{xcode_project_path}")
    end
    
    UI.message("Using project: #{project_path}")
    
    # Set up code signing with match
    match(
      type: "appstore",
      app_identifier: app_identifier,
      git_url: ENV["MATCH_REPOSITORY"],
      readonly: true,
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: ""
    )
    
    # Update project settings
    update_project_provisioning(
      xcodeproj: project_path.end_with?('.xcworkspace') ? nil : project_path,
      target_filter: "Unity-iPhone",
      profile: ENV["sigh_#{app_identifier}_appstore_profile-path"] || Actions.lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][app_identifier],
      build_configuration: "Release"
    )
    
    # Update project team
    update_project_team(
      path: project_path.end_with?('.xcworkspace') ? nil : project_path,
      teamid: ENV["APP_STORE_CONNECT_TEAM_ID"]
    )
    
    # Increment build number
    increment_build_number(
      xcodeproj: project_path.end_with?('.xcworkspace') ? nil : project_path
    )
    
    # Update version number if provided
    if app_version
      increment_version_number(
        version_number: app_version,
        xcodeproj: project_path.end_with?('.xcworkspace') ? nil : project_path
      )
    end
    
    # Build the app
    if project_path.end_with?('.xcworkspace')
      build_app(
        workspace: project_path,
        scheme: "Unity-iPhone",
        configuration: "Release",
        export_method: "app-store"
      )
    else
      build_app(
        project: project_path,
        scheme: "Unity-iPhone",
        configuration: "Release",
        export_method: "app-store"
      )
    end
    
    # Upload to App Store
    upload_to_app_store(
      force: true,
      reject_if_possible: true,
      skip_metadata: false,
      skip_screenshots: true,
      submit_for_review: false
    )
    
    UI.success("Successfully uploaded #{app_name} v#{app_version} to App Store! 🎉")
  end
  
  # Helper method to find project or workspace
  private_lane :find_project_or_workspace do |options|
    path = options[:path] || "."
    
    # Look for workspace first
    workspace_files = Dir.glob(File.join(path, "**/*.xcworkspace"))
    return workspace_files.first if workspace_files.any?
    
    # Look for project
    project_files = Dir.glob(File.join(path, "**/*.xcodeproj"))
    return project_files.first if project_files.any?
    
    # Return nil if nothing found
    nil
  end
  
  desc "Download certificates and provisioning profiles"
  lane :certificates do
    app_identifier = ENV["APP_IDENTIFIER"]
    
    match(
      type: "appstore",
      app_identifier: app_identifier,
      git_url: ENV["MATCH_REPOSITORY"],
      readonly: true
    )
  end
  
  desc "Clean up build artifacts"
  lane :clean do
    clear_derived_data
    xcclean
    UI.success("Cleaned up build artifacts! 🧹")
  end
end

# Helper methods
def find_project_or_workspace(path)
  # Look for workspace first
  workspace_files = Dir.glob(File.join(path, "**/*.xcworkspace"))
  return workspace_files.first if workspace_files.any?
  
  # Look for project
  project_files = Dir.glob(File.join(path, "**/*.xcodeproj"))
  return project_files.first if project_files.any?
  
  # Return nil if nothing found
  nil
end
