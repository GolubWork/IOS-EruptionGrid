default_platform(:ios)

platform :ios do
  desc "Build iOS app"
  lane :build do
    podfile_path = File.join(ENV['XCODE_PROJECT_PATH'] || "#{Dir.pwd}/build/ios", "Podfile")
    project_path = File.join(ENV['XCODE_PROJECT_PATH'] || "#{Dir.pwd}/build/ios", "iOS/Unity-iPhone.xcodeproj")
    UI.message "Podfile path: #{podfile_path}"
    UI.message "Project path: #{project_path}"
    unless File.exist?(project_path)
      UI.user_error!("Xcode project not found at #{project_path}. Make sure the Unity build artifact is downloaded and the path is correct.")
    end
    if File.exist?(podfile_path)
      cocoapods(podfile: podfile_path, repo_update: false)
    end
    build_app(
      project: project_path, # Unity Xcode project
      scheme: "Unity-iPhone",   # Unity scheme
      export_method: "app-store"
    )
    UI.message "Build output path: #{lane_context[SharedValues::BUILD_APP_OUTPUT_PATH]}"
  end

  desc "Build and upload to App Store Connect"
  lane :release do
    podfile_path = File.join(ENV['XCODE_PROJECT_PATH'] || "#{Dir.pwd}/build/ios", "Podfile")
    project_path = File.join(ENV['XCODE_PROJECT_PATH'] || "#{Dir.pwd}/build/ios", "iOS/Unity-iPhone.xcodeproj")
    UI.message "Podfile path: #{podfile_path}"
    UI.message "Project path: #{project_path}"
    unless File.exist?(project_path)
      UI.user_error!("Xcode project not found at #{project_path}. Make sure the Unity build artifact is downloaded and the path is correct.")
    end
    if File.exist?(podfile_path)
      cocoapods(podfile: podfile_path, repo_update: false)
    end
    build_app(
      project: project_path,
      scheme: "Unity-iPhone",
      export_method: "app-store"
    )
    UI.message "Build output path: #{lane_context[SharedValues::BUILD_APP_OUTPUT_PATH]}"
    upload_to_app_store(
      username: ENV['APPLE_CONNECT_EMAIL'],
      app_identifier: ENV['IOS_BUNDLE_ID'],
      team_id: ENV['APPLE_TEAM_ID'],
      skip_metadata: true,
      skip_screenshots: true,
      force: true
    )
  end
end
