default_platform(:ios)

platform :ios do
  desc "Build iOS app"
  lane :build do
    cocoapods
        build_app(
          workspace: "Unity-iPhone.xcworkspace", # Default Unity workspace
          scheme: "Unity-iPhone",               # Default Unity scheme
          export_method: "app-store"            # Or 'ad-hoc', 'development', etc.
    )
  end
  
    desc "Build and upload to App Store Connect"
    lane :release do
        cocoapods
        build_app(
          workspace: "Unity-iPhone.xcworkspace",
          scheme: "Unity-iPhone",
          export_method: "app-store"
        )
        upload_to_app_store(
          username: ENV['APPLE_CONNECT_EMAIL'],
          app_identifier: ENV['IOS_BUNDLE_ID'],
          team_id: ENV['APPLE_TEAM_ID'],
          skip_metadata: true,
          skip_screenshots: true
        )
    end
end
